{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "tools=(self)"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        }
      ]
    }
  ]
}
